{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casabre.github.io/agent-definition-protocol/schemas/adp.schema.json",
  "title": "Agent Definition Protocol v0.3.0",
  "type": "object",
  "required": ["adp_version", "id", "runtime", "flow", "evaluation"],
  "properties": {
    "adp_version": {"type": "string", "enum": ["0.1.0", "0.2.0", "0.3.0"]},
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "owner": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "conformance_class": {
      "type": "string",
      "enum": ["minimal", "full"],
      "description": "Explicit conformance class declaration. If absent, implementations infer class from content (empty flow/evaluation = minimal). 'full' requires non-empty flow and evaluation.",
      "$comment": "v0.1.1. SDKs MUST enforce: conformance_class=full + empty flow/evaluation is an error."
    },
    "runtime": {"$ref": "runtime.schema.json"},
    "flow": {"$ref": "flow.schema.json"},
    "prompts": {
      "type": "object",
      "properties": {
        "system": {"type": "string"},
        "roles": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
          "required": ["id", "name", "description"],
          "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "input_modes": {"type": "array", "items": {"type": "string"}},
          "output_modes": {"type": "array", "items": {"type": "string"}},
          "examples": {"type": "array", "items": {"type": "string"}},
          "tags": {"type": "array", "items": {"type": "string"}},
          "visibility": {
            "type": "string",
            "enum": ["public", "authenticated"],
            "default": "public",
            "description": "public: appears in the public A2A agent card. authenticated: appears only in the authenticated extension card."
          }
        },
        "additionalProperties": true
      }
    },
    "subagents": {
      "type": "array",
      "description": "Catalog of sub-agent references this agent can delegate to.",
      "items": {
        "type": "object",
        "required": ["id", "ref"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "description": "URI or relative path to the sub-agent ADP manifest." },
          "description": { "type": "string" },
          "invocation_mode": { "type": "string", "enum": ["synchronous", "asynchronous"] }
        },
        "additionalProperties": false
      }
    },
    "pipeline": {
      "type": "object",
      "description": "In-band processing stages. guardrails.input → pre_process → flow → post_process → guardrails.output.",
      "properties": {
        "pre_process": { "type": "array", "items": { "$ref": "#/definitions/pipeline_stage" } },
        "post_process": { "type": "array", "items": { "$ref": "#/definitions/pipeline_stage" } }
      },
      "additionalProperties": false
    },
    "hooks": {
      "type": "array",
      "description": "Lifecycle event handlers. Fire-and-forget; do not modify the data flow.",
      "items": { "$ref": "#/definitions/hook" }
    },
    "streaming": {
      "type": "object",
      "description": "Agent streaming policy.",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "mode": { "type": "string", "enum": ["token", "message", "event", "none"], "default": "token" },
        "chunk_format": { "type": "string", "enum": ["text", "json", "server_sent_events"], "default": "text" },
        "buffer_lines": { "type": "integer", "minimum": 0, "default": 0 },
        "include_node_events": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "interop": {
      "type": "object",
      "properties": {
        "a2a": {
          "type": "object",
          "properties": {
            "ref": { "type": "string", "description": "URI or file path to an external A2A AgentCard document." },
            "agentcard": { "type": "object", "additionalProperties": true, "$comment": "Deprecated alias for agent_card. Use agent_card (snake_case)." },
            "card_url": { "type": "string", "format": "uri", "description": "The public URL where this agent card is served." },
            "agent_card": { "$ref": "#/definitions/a2a_agent_card" },
            "authenticated_extension": { "$ref": "#/definitions/a2a_authenticated_extension" }
          },
          "additionalProperties": true
        },
        "agentspec": {
          "type": "object",
          "description": "Oracle AgentSpec interoperability mapping. Declares this manifest's relationship to an AgentSpec configuration and provides identity bridges for round-trip tooling. All fields are optional.",
          "properties": {
            "ref": {
              "type": "string",
              "description": "URI or relative file path to the AgentSpec YAML/JSON configuration file."
            },
            "version": {
              "type": "string",
              "pattern": "^\\d{2}\\.\\d+\\.\\d+$",
              "description": "AgentSpec calendar version (YY.minor.patch) using a two-digit calendar-year prefix (e.g., '26.2.0' for 2026). Single-digit years are not valid under this scheme."
            },
            "component_type": {
              "type": "string",
              "enum": ["Agent", "Flow"],
              "description": "The AgentSpec root component type this manifest maps to."
            },
            "component_id": {
              "type": "string",
              "format": "uuid",
              "description": "UUID of the root AgentSpec component, preserved for round-trip identity."
            },
            "runtime_adapters": {
              "type": "array",
              "items": { "type": "string" },
              "description": "AgentSpec-compatible runtime adapters that can execute this manifest (e.g., 'wayflow', 'langgraph', 'autogen', 'crewai')."
            },
            "node_map": {
              "type": "object",
              "additionalProperties": { "type": "string", "format": "uuid" },
              "description": "Maps ADP flow node IDs to AgentSpec component UUIDs. Keys MUST match node IDs in flow.graph.nodes."
            },
            "llm_map": {
              "type": "array",
              "description": "Maps ADP runtime execution backends to AgentSpec LLM config components.",
              "items": {
                "type": "object",
                "required": ["backend_id", "agentspec_id"],
                "properties": {
                  "backend_id": {
                    "type": "string",
                    "description": "ID of the ADP runtime.execution entry. MUST match an id in runtime.execution."
                  },
                  "agentspec_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "UUID of the AgentSpec LLM config component."
                  },
                  "agentspec_type": {
                    "type": "string",
                    "description": "AgentSpec LLM config type (e.g., 'OpenAiConfig', 'OciGenAiConfig', 'VllmConfig', 'OllamaConfig')."
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "object",
      "properties": {
        "mcp_servers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description", "transport", "endpoint"],
            "properties": {
              "id": {"type": "string"},
              "description": {"type": "string"},
              "transport": {"type": "string"},
              "endpoint": {"type": "string"},
              "auth": {
                "type": "object",
                "required": ["scheme"],
                "properties": {
                  "scheme": {"type": "string", "enum": ["bearer", "api_key", "oauth2", "mtls", "none"]},
                  "env_var": {"type": "string"},
                  "scopes": {"type": "array", "items": {"type": "string"}}
                },
                "additionalProperties": false
              },
              "load_strategy": {
                "type": "string",
                "enum": ["eager", "lazy", "on_demand"],
                "default": "eager",
                "description": "eager: full schema loaded at invocation start; lazy: schema loaded on first actual use; on_demand: only description shown upfront, full schema injected when LLM emits tool-request signal"
              },
              "policy": {
                "type": "object",
                "description": "Tool invocation policy.",
                "properties": {
                  "retry": {
                    "type": "object",
                    "properties": {
                      "max_attempts": {"type": "integer", "minimum": 1, "default": 3},
                      "backoff": {"type": "string", "enum": ["fixed", "linear", "exponential"], "default": "exponential"},
                      "backoff_base_ms": {"type": "integer", "minimum": 0, "default": 500},
                      "max_delay_ms": {"type": "integer", "minimum": 0, "default": 10000},
                      "retryable_status_codes": {"type": "array", "items": {"type": "integer"}}
                    },
                    "additionalProperties": false
                  },
                  "timeout_ms": {"type": "integer", "minimum": 1},
                  "rate_limit": {
                    "type": "object",
                    "properties": {
                      "requests_per_minute": {"type": "integer", "minimum": 1},
                      "burst": {"type": "integer", "minimum": 0},
                      "on_limit_exceeded": {"type": "string", "enum": ["queue", "fail", "warn"], "default": "queue"}
                    },
                    "additionalProperties": false
                  },
                  "cache": {
                    "type": "object",
                    "properties": {
                      "enabled": {"type": "boolean", "default": false},
                      "ttl_seconds": {"type": "integer", "minimum": 0},
                      "key_fields": {"type": "array", "items": {"type": "string"}},
                      "scope": {"type": "string", "enum": ["agent", "session", "user"]}
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "http_apis": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description", "base_url"],
            "properties": {
              "id": {"type": "string"},
              "description": {"type": "string"},
              "base_url": {"type": "string"},
              "auth": {
                "type": "object",
                "required": ["scheme"],
                "properties": {
                  "scheme": {"type": "string", "enum": ["bearer", "api_key", "oauth2", "mtls", "none"]},
                  "env_var": {"type": "string"},
                  "scopes": {"type": "array", "items": {"type": "string"}}
                },
                "additionalProperties": false
              },
              "load_strategy": {
                "type": "string",
                "enum": ["eager", "lazy", "on_demand"],
                "default": "eager",
                "description": "eager: full schema loaded at invocation start; lazy: schema loaded on first actual use; on_demand: only description shown upfront, full schema injected when LLM emits tool-request signal"
              },
              "policy": {
                "type": "object",
                "description": "Tool invocation policy.",
                "properties": {
                  "retry": {
                    "type": "object",
                    "properties": {
                      "max_attempts": {"type": "integer", "minimum": 1, "default": 3},
                      "backoff": {"type": "string", "enum": ["fixed", "linear", "exponential"], "default": "exponential"},
                      "backoff_base_ms": {"type": "integer", "minimum": 0, "default": 500},
                      "max_delay_ms": {"type": "integer", "minimum": 0, "default": 10000},
                      "retryable_status_codes": {"type": "array", "items": {"type": "integer"}}
                    },
                    "additionalProperties": false
                  },
                  "timeout_ms": {"type": "integer", "minimum": 1},
                  "rate_limit": {
                    "type": "object",
                    "properties": {
                      "requests_per_minute": {"type": "integer", "minimum": 1},
                      "burst": {"type": "integer", "minimum": 0},
                      "on_limit_exceeded": {"type": "string", "enum": ["queue", "fail", "warn"], "default": "queue"}
                    },
                    "additionalProperties": false
                  },
                  "cache": {
                    "type": "object",
                    "properties": {
                      "enabled": {"type": "boolean", "default": false},
                      "ttl_seconds": {"type": "integer", "minimum": 0},
                      "key_fields": {"type": "array", "items": {"type": "string"}},
                      "scope": {"type": "string", "enum": ["agent", "session", "user"]}
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "sql_functions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description", "connection"],
            "properties": {
              "id": {"type": "string"},
              "description": {"type": "string"},
              "connection": {"type": "string"},
              "schema": {"type": "string"},
              "auth": {
                "type": "object",
                "required": ["scheme"],
                "properties": {
                  "scheme": {"type": "string", "enum": ["bearer", "api_key", "oauth2", "mtls", "none"]},
                  "env_var": {"type": "string"},
                  "scopes": {"type": "array", "items": {"type": "string"}}
                },
                "additionalProperties": false
              },
              "load_strategy": {
                "type": "string",
                "enum": ["eager", "lazy", "on_demand"],
                "default": "eager",
                "description": "eager: full schema loaded at invocation start; lazy: schema loaded on first actual use; on_demand: only description shown upfront, full schema injected when LLM emits tool-request signal"
              },
              "policy": {
                "type": "object",
                "description": "Tool invocation policy.",
                "properties": {
                  "retry": {
                    "type": "object",
                    "properties": {
                      "max_attempts": {"type": "integer", "minimum": 1, "default": 3},
                      "backoff": {"type": "string", "enum": ["fixed", "linear", "exponential"], "default": "exponential"},
                      "backoff_base_ms": {"type": "integer", "minimum": 0, "default": 500},
                      "max_delay_ms": {"type": "integer", "minimum": 0, "default": 10000},
                      "retryable_status_codes": {"type": "array", "items": {"type": "integer"}}
                    },
                    "additionalProperties": false
                  },
                  "timeout_ms": {"type": "integer", "minimum": 1},
                  "rate_limit": {
                    "type": "object",
                    "properties": {
                      "requests_per_minute": {"type": "integer", "minimum": 1},
                      "burst": {"type": "integer", "minimum": 0},
                      "on_limit_exceeded": {"type": "string", "enum": ["queue", "fail", "warn"], "default": "queue"}
                    },
                    "additionalProperties": false
                  },
                  "cache": {
                    "type": "object",
                    "properties": {
                      "enabled": {"type": "boolean", "default": false},
                      "ttl_seconds": {"type": "integer", "minimum": 0},
                      "key_fields": {"type": "array", "items": {"type": "string"}},
                      "scope": {"type": "string", "enum": ["agent", "session", "user"]}
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "sandbox": {
          "$ref": "sandbox.schema.json"
        }
      },
      "additionalProperties": false
    },
    "memory": {
      "oneOf": [
        {
          "title": "Legacy v0.1.x memory format (backward compatibility)",
          "type": "object",
          "properties": {
            "provider": {"type": "string"},
            "endpoint": {"type": "string"},
            "index": {"type": "string"},
            "namespace": {"type": "string"}
          },
          "additionalProperties": false
        },
        {
          "title": "Structured v0.3.0 memory format",
          "$ref": "memory.schema.json"
        }
      ]
    },
    "workspace": {"$ref": "workspace.schema.json"},
    "artifacts": {"$ref": "artifacts.schema.json"},
    "observability": {"$ref": "observability.schema.json"},
    "guardrails": {
      "type": "object",
      "description": "Guardrail declarations for input/output filtering (v0.2.0) plus interrupts, cost, and agent trust (v0.3.0).",
      "properties": {
        "input": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "provider", "policy_ref"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "provider": {"type": "string"},
              "policy_ref": {"type": "string"},
              "mode": {"type": "string", "enum": ["block", "flag", "redact", "log"]},
              "categories": {"type": "array", "items": {"type": "string"}},
              "threshold": {"type": "string", "enum": ["low", "medium", "high"]}
            },
            "additionalProperties": false
          }
        },
        "output": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "provider", "policy_ref"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "provider": {"type": "string"},
              "policy_ref": {"type": "string"},
              "mode": {"type": "string", "enum": ["block", "flag", "redact", "log"]},
              "categories": {"type": "array", "items": {"type": "string"}},
              "threshold": {"type": "string", "enum": ["low", "medium", "high"]}
            },
            "additionalProperties": false
          }
        },
        "on_violation": {"type": "string", "enum": ["block", "log"]},
        "interrupts": {
          "type": "array",
          "description": "Human-in-the-loop interrupts.",
          "items": {
            "type": "object",
            "required": ["id", "trigger", "mode"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "trigger": {
                "type": "string",
                "enum": ["tool_call", "cost_threshold", "loop_max_exceeded", "custom"]
              },
              "tool_refs": {
                "type": "array",
                "items": {"type": "string"},
                "description": "Which tool IDs trigger this (for tool_call trigger)"
              },
              "mode": {
                "type": "string",
                "enum": ["pause_and_notify", "block", "log"],
                "description": "pause_and_notify is always blocking by definition; execution_mode only applies to block or log modes"
              },
              "execution_mode": {
                "type": "string",
                "enum": ["blocking", "parallel"],
                "description": "Only valid when mode is 'block' or 'log'. blocking: check completes BEFORE agent invocation; parallel: check runs concurrently with agent"
              },
              "notification": {
                "type": "object",
                "properties": {
                  "channel": {"type": "string", "enum": ["webhook"]},
                  "endpoint_env_var": {"type": "string"},
                  "timeout_seconds": {"type": "integer", "minimum": 1},
                  "on_timeout": {"type": "string", "enum": ["fail", "approve", "deny"]}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "cost": {
          "type": "object",
          "description": "Cost guardrails - active enforcement.",
          "properties": {
            "threshold_usd": {"type": "number", "minimum": 0},
            "on_threshold_exceeded": {
              "type": "string",
              "enum": ["block", "warn", "interrupt", "downgrade"]
            },
            "interrupt_ref": {
              "type": "string",
              "description": "Required when on_threshold_exceeded='interrupt'; references guardrails.interrupts[].id"
            },
            "downgrade_model_ref": {
              "type": "string",
              "description": "Required when on_threshold_exceeded='downgrade'; references runtime.models[].id"
            },
            "track_by": {
              "type": "string",
              "enum": ["invocation", "session", "user", "day"]
            },
            "model_refs": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Absent = all models"
            }
          },
          "additionalProperties": false
        },
        "agent_trust": {
          "type": "object",
          "description": "Agent trust level with normative enforcement table.",
          "properties": {
            "level": {
              "type": "string",
              "enum": ["sandboxed", "supervised", "autonomous"]
            },
            "side_effect_tool_refs": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Tools classified as write/side-effect"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "evaluation": {"$ref": "evaluation.schema.json"},
    "kpis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "url"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "target": {"type": ["string", "number"]},
          "unit": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "governance": {
      "type": "object",
      "properties": {
        "identity": {"type": "string"},
        "allowed_data_scopes": {"type": "array", "items": {"type": "string"}},
        "forbidden_data_scopes": {"type": "array", "items": {"type": "string"}},
        "telemetry_endpoint": {
          "type": "string",
          "format": "uri",
          "$comment": "Deprecated in v0.2.0; use top-level telemetry section. Will be removed in v0.3.0."
        },
        "guardrail_policy_set": {"type": "string"},
        "compliance": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["standard"],
            "properties": {
              "standard": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "extends": {
      "type": "string",
      "description": "URI of a base ADP manifest. Merged using RFC 7396 JSON Merge Patch before local fields."
    },
    "import": {
      "type": "array",
      "description": "Modules to import additively (arrays appended, objects deep-merged). Applied after extends, before local fields.",
      "items": {
        "type": "object",
        "required": ["id", "from"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "from": {"type": "string"},
          "sections": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "overrides": {
      "type": "array",
      "description": "RFC 6901 JSON Pointer patches applied last, after extends, id-keyed local fields, and import.",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {"type": "string"},
          "value": {},
          "op": {"type": "string", "enum": ["set", "delete", "append"]}
        },
        "additionalProperties": false
      }
    },
    "telemetry": {
      "type": "object",
      "description": "OpenTelemetry configuration. Replaces deprecated governance.telemetry_endpoint.",
      "properties": {
        "endpoint": {"type": "string"},
        "protocol": {"type": "string", "enum": ["grpc", "http/protobuf", "http/json"]},
        "service_name": {"type": "string"},
        "sampling_rate": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "required_attributes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "properties": {
        "environments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "endpoint"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "endpoint": {"type": "string", "format": "uri"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "x_testing": {
      "$comment": "ADP Testing extension (preview). Will be promoted to top-level 'testing' in v0.3.0. Validate x_testing content against schemas/testing.schema.json.",
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "definitions": {
    "pipeline_stage": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["function", "script", "json_schema"] },
        "function_ref": { "type": "string" },
        "runtime": { "type": "string", "enum": ["python", "bash", "javascript"] },
        "inline": { "type": "string" },
        "script_ref": { "type": "string" },
        "schema": { "type": "object", "additionalProperties": true },
        "schema_ref": { "type": "string" },
        "on_error": { "type": "string", "enum": ["fail", "warn", "skip"] }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": {"properties": {"type": {"const": "function"}}, "required": ["type"]}, "then": {"required": ["function_ref"]} },
        { "if": {"properties": {"type": {"const": "script"}}, "required": ["type"]}, "then": {"anyOf": [{"required": ["inline"]}, {"required": ["script_ref"]}]} },
        { "if": {"properties": {"type": {"const": "json_schema"}}, "required": ["type"]}, "then": {"anyOf": [{"required": ["schema"]}, {"required": ["schema_ref"]}]} }
      ]
    },
    "hook": {
      "type": "object",
      "required": ["event", "handler"],
      "properties": {
        "event": { "type": "string", "enum": ["on_invoke_start", "on_invoke_end", "on_node_start", "on_node_end", "on_stream_start", "on_stream_chunk", "on_stream_end", "on_error"] },
        "node_filter": { "type": "array", "items": { "type": "string" }, "description": "Limit hook to these node IDs. Only applicable to on_node_start/on_node_end." },
        "handler": { "$ref": "#/definitions/hook_handler" },
        "on_error": { "type": "string", "enum": ["log", "fail", "skip"] }
      },
      "additionalProperties": false
    },
    "hook_handler": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["function", "script"] },
        "function_ref": { "type": "string" },
        "runtime": { "type": "string", "enum": ["python", "bash", "javascript"] },
        "inline": { "type": "string" },
        "script_ref": { "type": "string" }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": {"properties": {"type": {"const": "function"}}, "required": ["type"]}, "then": {"required": ["function_ref"]} },
        { "if": {"properties": {"type": {"const": "script"}}, "required": ["type"]}, "then": {"anyOf": [{"required": ["inline"]}, {"required": ["script_ref"]}]} }
      ]
    },
    "a2a_agent_card": {
      "type": "object",
      "required": ["name", "url", "version"],
      "description": "A2A-protocol public AgentCard.",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "version": { "type": "string" },
        "documentation_url": { "type": "string", "format": "uri" },
        "provider": {
          "type": "object",
          "properties": { "organization": { "type": "string" }, "url": { "type": "string", "format": "uri" } },
          "additionalProperties": false
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "streaming": { "type": "boolean" },
            "push_notifications": { "type": "boolean" },
            "state_transition_history": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "authentication": { "$ref": "#/definitions/a2a_authentication" },
        "default_input_modes": { "type": "array", "items": { "type": "string" } },
        "default_output_modes": { "type": "array", "items": { "type": "string" } },
        "skills": { "type": "array", "items": { "$ref": "#/definitions/a2a_skill" } }
      },
      "additionalProperties": false
    },
    "a2a_authenticated_extension": {
      "type": "object",
      "description": "Delta over the public agent card. Arrays are additive; scalars override.",
      "properties": {
        "capabilities": {
          "type": "object",
          "properties": {
            "streaming": { "type": "boolean" },
            "push_notifications": { "type": "boolean" },
            "state_transition_history": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "authentication": { "$ref": "#/definitions/a2a_authentication" },
        "default_input_modes": { "type": "array", "items": { "type": "string" } },
        "default_output_modes": { "type": "array", "items": { "type": "string" } },
        "skills": { "type": "array", "items": { "$ref": "#/definitions/a2a_skill" } },
        "push_notification_config": {
          "type": "object",
          "properties": {
            "endpoint": { "type": "string", "format": "uri" },
            "auth_scheme": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "a2a_authentication": {
      "type": "object",
      "required": ["schemes"],
      "properties": {
        "schemes": { "type": "array", "items": { "type": "string" } },
        "credentials": { "type": "string" },
        "oauth2": {
          "type": "object",
          "properties": {
            "authorization_url": { "type": "string", "format": "uri" },
            "token_url": { "type": "string", "format": "uri" },
            "scopes": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "a2a_skill": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "examples": { "type": "array", "items": { "type": "string" } },
        "input_modes": { "type": "array", "items": { "type": "string" } },
        "output_modes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
