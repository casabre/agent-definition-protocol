{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casabre.github.io/agent-definition-protocol/schemas/runtime.schema.json",
  "title": "ADP Runtime v0.1.0",
  "type": "object",
  "required": ["execution"],
  "properties": {
    "execution": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/backend"}
    },
    "models": {
      "$comment": "v0.2.0 — forward-declared; accepted but not formally specified in v0.1.0",
      "type": "array",
      "description": "Model configurations for LLM nodes (v0.2.0+)",
      "items": {"$ref": "#/definitions/model"},
      "minItems": 0
    },
    "adapter_hints": {
      "type": "object",
      "description": "Framework-specific configuration hints consumed by SDK integrations.",
      "properties": {
        "langgraph": {
          "type": "object",
          "properties": {
            "recursion_limit": { "type": "integer", "minimum": 1 },
            "stream_mode": { "type": "string", "enum": ["values", "updates", "debug"] },
            "checkpointer": { "type": "string", "enum": ["memory", "sqlite", "postgres", "none"] },
            "memory_store": { "type": "string" }
          },
          "additionalProperties": true
        },
        "autogen": {
          "type": "object",
          "properties": {
            "max_turns": { "type": "integer", "minimum": 1 },
            "human_input_mode": { "type": "string", "enum": ["NEVER", "TERMINATE", "ALWAYS"] }
          },
          "additionalProperties": true
        },
        "crewai": {
          "type": "object",
          "properties": {
            "process": { "type": "string", "enum": ["sequential", "hierarchical", "parallel"] },
            "verbose": { "type": "boolean" },
            "memory": { "type": "boolean" },
            "embedder_config": {
              "type": "object",
              "properties": {
                "provider": { "type": "string" },
                "model": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "semantic_kernel": {
          "type": "object",
          "properties": {
            "execution_type": { "type": "string", "enum": ["sequential", "stepwise"] }
          },
          "additionalProperties": true
        },
        "llamaindex": {
          "type": "object",
          "properties": {
            "query_engine": { "type": "string" },
            "vector_store": { "type": "string" }
          },
          "additionalProperties": true
        },
        "google_adk": {
          "type": "object",
          "properties": {
            "artifact_service": { "type": "string", "enum": ["inmemory", "gcs"] },
            "session_service": { "type": "string" }
          },
          "additionalProperties": true
        },
        "openai_agents": {
          "type": "object",
          "properties": {
            "tracing": { "type": "string", "enum": ["otlp", "langfuse", "none"] },
            "sandbox_provider": { "type": "string" }
          },
          "additionalProperties": true
        },
        "pydantic_ai": {
          "type": "object",
          "properties": {
            "strict_mode": { "type": "boolean" },
            "model": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "definitions": {
    "repo": {
      "type": "object",
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "path": {"type": "string"},
        "ref": {"type": "string"}
      },
      "additionalProperties": false
    },
    "healthcheck": {
      "type": "object",
      "properties": {
        "path": {"type": "string"},
        "command": {"type": "string"},
        "interval_seconds": {"type": "integer", "minimum": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "cpu": {"type": "string"},
        "memory": {"type": "string"},
        "gpu": {"type": "string"}
      },
      "additionalProperties": false
    },
    "logging": {
      "type": "object",
      "properties": {
        "level": {"type": "string"},
        "destination": {"type": "string"}
      },
      "additionalProperties": false
    },
    "backend": {
      "type": "object",
      "required": ["id", "backend"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "backend": {
          "type": "string",
          "enum": ["docker", "wasm", "python", "typescript", "binary", "custom"]
        },
        "type": {"type": "string"},
        "repo": {"$ref": "#/definitions/repo"},
        "source": {
          "type": "object",
          "properties": {
            "mode": {"type": "string"},
            "repo": {"type": "string"},
            "path": {"type": "string"},
            "ref": {"type": "string"},
            "inline": {"type": "string"}
          },
          "additionalProperties": false
        },
        "inline_source": {"type": "string"},
        "entrypoint": {"type": ["string", "array"], "items": {"type": "string"}},
        "image": {"type": "string", "pattern": "^[\\w./:-]+$"},
        "module": {"type": "string"},
        "exported_functions": {"type": "array", "items": {"type": "string"}},
        "wasi": {"type": "boolean"},
        "memory": {
          "type": "object",
          "properties": {
            "max_mb": {"type": "integer"}
          },
          "additionalProperties": false
        },
        "command": {
          "type": "array",
          "items": {"type": "string"}
        },
        "ports": {
          "type": "array",
          "items": {"type": "string"}
        },
        "args": {
          "type": "array",
          "items": {"type": "string"}
        },
        "environment": {"type": "object", "additionalProperties": {"type": "string"}},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "package_manager": {"type": "string"},
        "build_cmd": {"type": "string"},
        "path": {"type": "string"},
        "endpoint": {"type": "string", "format": "uri"},
        "env": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "resources": {"$ref": "#/definitions/resources"},
        "logging": {"$ref": "#/definitions/logging"},
        "healthcheck": {"$ref": "#/definitions/healthcheck"},
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"backend": {"const": "docker"}}, "required": ["backend"]},
          "then": {"required": ["image"]}
        },
        {
          "if": {"properties": {"backend": {"const": "wasm"}}, "required": ["backend"]},
          "then": {"required": ["module"]}
        },
        {
          "if": {"properties": {"backend": {"const": "python"}}, "required": ["backend"]},
          "then": {"required": ["entrypoint"]}
        },
        {
          "if": {"properties": {"backend": {"const": "typescript"}}, "required": ["backend"]},
          "then": {"required": ["entrypoint", "package_manager"]}
        },
        {
          "if": {"properties": {"backend": {"const": "binary"}}, "required": ["backend"]},
          "then": {"required": ["path"]}
        },
        {
          "if": {"properties": {"backend": {"const": "custom"}}, "required": ["backend"]},
          "then": {"required": ["type", "endpoint"]}
        }
      ]
    },
    "model": {
      "type": "object",
      "required": ["id", "provider", "model"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "api_key_env": {"type": "string"},
        "base_url": {"type": "string", "format": "uri"},
        "temperature": {"type": "number"},
        "max_tokens": {"type": "integer"},
        "extensions": {
          "type": "object",
          "additionalProperties": true,
          "$comment": "Prefer explicit fields over extensions; extensions is the fallback for provider-specific params not yet in schema"
        },
        "top_p": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "seed": {"type": "integer"},
        "timeout_ms": {"type": "integer", "minimum": 1},
        "use_streaming_api": {
          "type": "boolean",
          "description": "Call provider API in streaming mode internally (buffers tokens before returning if top-level streaming.enabled: false)"
        },
        "stop_sequences": {
          "type": "array",
          "items": {"type": "string"},
          "maxItems": 4
        },
        "frequency_penalty": {"type": "number", "minimum": -2.0, "maximum": 2.0},
        "presence_penalty": {"type": "number", "minimum": -2.0, "maximum": 2.0},
        "structured_output": {
          "type": "object",
          "properties": {
            "format": {"type": "string", "enum": ["json_object", "json_schema", "text"]},
            "schema": {"type": "object", "additionalProperties": true},
            "schema_ref": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
